                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Café Postman {{$timestamp}}\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"price\": \"15,00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/menu/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu", "products"]
            }
          }
        },
        {
          "name": "Editar el producto",
          "event": [
            {
              "listen": "test",
