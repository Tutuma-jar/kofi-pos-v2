    {
      "name": "4. Ventas (SPEC-003)",
      "item": [
        {
          "name": "Calcular la venta en preparación",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200 con el total calculado', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().totalCents).to.be.above(0);",
                  "});",
                  "const line = pm.response.json().lines[0];",
                  "pm.collectionVariables.set('productName', line.productName);",
                  "pm.collectionVariables.set('unitPriceCents', line.unitPriceCents);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lines\": [\n    { \"productId\": \"{{productId}}\", \"productName\": \"Café Postman\", \"quantity\": 2 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sales/quote",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sales", "quote"]
            }
          }
        },
        {
          "name": "Rechazar una venta sin productos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('responde 400', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"draftId\": \"{{$guid}}\",\n  \"paymentMethod\": \"cash\",\n  \"lines\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sales",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sales"]
            }
          }
        },
        {
          "name": "Registrar una venta pagada",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201 con el número de venta', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().sale.number).to.be.above(0);",
                  "});",
                  "pm.collectionVariables.set('saleNumber', pm.response.json().sale.number);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"draftId\": \"{{$guid}}\",\n  \"paymentMethod\": \"qr\",\n  \"lines\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"productName\": \"{{productName}}\",\n      \"quantity\": 2,\n      \"unitPriceCents\": {{unitPriceCents}}\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sales",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sales"]
            }
          }
        }
      ]
    },
