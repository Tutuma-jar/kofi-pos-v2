{
  "info": {
    "name": "Kofi POS — API",
    "description": "Endpoints de la API de Kofi POS (Fastify), agrupados por módulo. La sesión viaja en la cookie `kofi_session`, que Postman guarda al iniciar sesión.\n\nUsa el entorno `Kofi POS — prueba` (`kofi-pos-prueba.postman_environment.json`) contra una API de prueba con su propia base: las carpetas de Menú y Ventas crean categorías, productos y ventas que no se pueden eliminar. Ejecuta las carpetas en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "categoryId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "productName", "value": "" },
    { "key": "unitPriceCents", "value": "" },
    { "key": "saleNumber", "value": "" }
  ],
  "item": [
    {
      "name": "1. Salud",
      "item": [
        {
          "name": "Comprobar la API",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200 con status ok', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Acceso (SPEC-001)",
      "item": [
        {
          "name": "Rechazar un ingreso sin datos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('responde 400', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Iniciar sesión como dueño",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200 con el rol owner', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().user.role).to.eql('owner');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{ownerUsername}}\",\n  \"password\": \"{{ownerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Consultar la sesión",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('responde 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "session"]
            }
          }
        }
      ]
    },
