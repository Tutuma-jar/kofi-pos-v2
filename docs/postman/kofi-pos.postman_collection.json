          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sin precio\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"price\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/menu/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu", "products"]
            }
          }
        },
        {
          "name": "Crear un producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
