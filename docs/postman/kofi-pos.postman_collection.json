          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman {{$timestamp}}\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/menu/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu", "categories"]
            }
          }
        },
        {
          "name": "Editar la categoría",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('responde 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman editada {{$timestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/menu/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "menu", "categories", "{{categoryId}}"]
            }
