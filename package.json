{
  "name": "kofi-pos",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "node scripts/git-hooks/install.mjs && node scripts/sync-skills.mjs && node scripts/sync-agents.mjs",
    "hooks": "node scripts/git-hooks/status.mjs",
    "test:git": "node --test scripts/git-rules.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
