{
  "name": "@kofi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/shared/database/migrations', 'dist/shared/database/migrations', { recursive: true })\"",
    "start": "node dist/shared/database/migrate.js && node dist/server.js",
    "migrate": "node --env-file-if-exists=.env src/shared/database/migrate.ts",
    "accounts": "node --env-file-if-exists=.env src/modules/auth/accounts.cli.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@kofi/contracts": "^0.0.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
